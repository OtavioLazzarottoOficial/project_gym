PORT=3000
DATABASE_URL=postgresql://base_local:base_local_dev@localhost:5433/base_local?schema=public
CORS_ORIGINS=http://localhost:5173
# Criadas localmente por npm run env:init; nunca copie chaves entre projetos.
JWT_PRIVATE_KEY=GENERATE_LOCALLY
JWT_PUBLIC_KEY=GENERATE_LOCALLY

# Envio de emails pelo Gmail (senha de app, nunca a senha comum)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173
