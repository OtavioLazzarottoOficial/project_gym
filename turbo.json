{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "JWT_PRIVATE_KEY",
        "JWT_PUBLIC_KEY",
        "VITE_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "NODE_ENV",
        "VITE_*",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "JWT_PRIVATE_KEY",
        "JWT_PUBLIC_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "JWT_PRIVATE_KEY",
        "JWT_PUBLIC_KEY",
        "VITE_*"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGINS",
        "JWT_PRIVATE_KEY",
        "JWT_PUBLIC_KEY",
        "VITE_*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
